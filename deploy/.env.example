# ===== 必填 =====
# saas = 多租户 SaaS;standalone = 独立部署(单租户,需要 License)
DEPLOYMENT_MODE=saas

# 数据库口令。仅用 URL 安全字符(字母数字、- _ .),因为会被拼进连接串
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
PLATFORM_DB_PASSWORD=change-me-platform

# 对外域名(Caddy 自动申请证书)
APP_DOMAIN=erp.example.com
CONSOLE_DOMAIN=console.example.com
ACME_EMAIL=ops@example.com

# 备份文件完整性签名密钥(HMAC),务必更换
BACKUP_HMAC_SECRET=change-me-backup-secret

# ===== SaaS 模式:首次启动创建平台管理员(已存在则跳过) =====
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=change-me-strong-password

# ===== 独立部署模式 =====
# Ed25519 公钥(PEM,换行写成 \n),用于校验 License 文件签名
# LICENSE_PUBLIC_KEY=
# STANDALONE_TENANT_NAME=默认企业
# STANDALONE_ADMIN_PHONE=13800000000

# ===== 可选 =====
# 微信小程序登录
# WECHAT_APPID=
# WECHAT_SECRET=
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# TZ=Asia/Shanghai
